# Default-deny context. Add only reviewed, portable product/build inputs.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!README.md
!LICENSE
!NOTICE
!THIRD_PARTY_NOTICES.md
!docker/
docker/**
!docker/runtime.json
!docker/python.lock
!docker/r-packages.lock.json
!docker/third-party-inventory.json
!docker/install-r.R
!config/
config/**
!config/gleskit.defaults.json
!src/
src/**
!src/gleskit_mcp/
src/gleskit_mcp/**
!src/gleskit_mcp/*.py
!src/gleskit_mcp/analysis/
src/gleskit_mcp/analysis/**
!src/gleskit_mcp/analysis/*.py
!src/gleskit_mcp/providers/
src/gleskit_mcp/providers/**
!src/gleskit_mcp/providers/*.py
!src/gleskit_mcp/web/
src/gleskit_mcp/web/**
!src/gleskit_mcp/web/*.py
!src/gleskit_mcp/r/
src/gleskit_mcp/r/**
!src/gleskit_mcp/r/*.R
!src/gleskit_mcp/report_templates/
src/gleskit_mcp/report_templates/**
!src/gleskit_mcp/report_templates/*.py
!src/gleskit_mcp/report_templates/*.json
!apps/
apps/**
!apps/web/
apps/web/**
!apps/web/package.json
!apps/web/package-lock.json
!apps/web/index.html
!apps/web/vite.config.js
!apps/web/scripts/
apps/web/scripts/**
!apps/web/scripts/build-web.mjs
!apps/web/src/
apps/web/src/**
!apps/web/src/*.js
!apps/web/src/*.mjs
!apps/web/src/*.css
!apps/web/src/assets/
apps/web/src/assets/**
!apps/web/src/assets/GESKit_icon.svg
!apps/web/src/assets/GESKit_icon_no_bg.png
!docs/
docs/**
!docs/opencode/
docs/opencode/**
!docs/opencode/prompts/
docs/opencode/prompts/**
!docs/opencode/prompts/agents/
docs/opencode/prompts/agents/**
!docs/opencode/prompts/agents/gleskit-agent-prompt.md
!docs/opencode/skills/
docs/opencode/skills/**
!docs/opencode/skills/gleskit-research-assistant/
docs/opencode/skills/gleskit-research-assistant/**
!docs/opencode/skills/gleskit-research-assistant/SKILL.md
!docs/opencode/skills/gleskit-research-assistant/references/
docs/opencode/skills/gleskit-research-assistant/references/**
!docs/opencode/skills/gleskit-research-assistant/references/*.md
!docs/opencode/skills/gleskit-research-assistant/references/pipeline/
docs/opencode/skills/gleskit-research-assistant/references/pipeline/**
!docs/opencode/skills/gleskit-research-assistant/references/pipeline/*.md
# Defense in depth: never admit private/generated files through a source rule.
**/.env
**/.env.*
**/*.local.*
**/__pycache__/
**/node_modules/
**/.git/
**/.aws/
**/.codex/
**/.secrets/
**/auth.json
**/providers.json
**/*.pem
**/*.key
