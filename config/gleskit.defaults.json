{
  "paths": {
    "workspace_root": "${PROJECT_ROOT}/var/gleskit_mcp",
    "runtime_root": "${PROJECT_ROOT}/var/gleskit_runtime",
    "reference_root": "${PROJECT_ROOT}/var/gleskit_reference",
    "r_lib_root": "${PROJECT_ROOT}/var/r_lib"
  },
  "runtime": {
    "default_species": "human",
    "runtime_ttl_seconds": 30,
    "local_max_workers": "auto",
    "r_threads": 1,
    "r_max_vsize": "100Gb",
    "local_r_timeout_seconds": 45,
    "figure_r_timeout_seconds": 45,
    "upload_preview_max_lines": 100,
    "artifact_preview_max_lines": 100
  },
  "tools": {
    "rscript_bin": "Rscript"
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8000,
    "streamable_http_path": "/mcp",
    "public_base_url": "",
    "download_public_base_url": "",
    "download_path_prefix": "/figure-download",
    "download_bind_host": "127.0.0.1",
    "download_port": 0,
    "figure_download_ttl_seconds": 1800,
    "figure_download_max_entries": 256
  }
}
